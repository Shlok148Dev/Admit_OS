# ==============================================================================
# Admit OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the appropriate values before starting.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database & Cache Configuration ---
# PostgreSQL Primary Database
DATABASE_URL=postgresql://postgres:<YOUR_SECURE_PASSWORD>@localhost:8001/admitos_db

# Redis Distributed Cache & Session Store
REDIS_URL=redis://localhost:6379/0

# --- Authentication & JWT Security ---
# Generate 32-byte cryptographic hex keys:
#   Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin Credentials ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_in_production

# --- AI Models & LLM Provider API Keys ---
# Google Gemini (Primary / Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Optional / Failover)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq Cloud (Optional / Fast Inference)
GROQ_API_KEY=your_groq_api_key_here

# --- Search & External Services ---
DUCKDUCKGO_SEARCH_ENABLED=true
MAX_SEARCH_RESULTS=5

# --- Microservices Endpoints (Internal / Docker) ---
COUNSELING_SERVICE_URL=http://localhost:8000
PREDICTION_SERVICE_URL=http://localhost:8002
AUTH_SERVICE_URL=http://localhost:8003
ANALYTICS_SERVICE_URL=http://localhost:8004
USER_SERVICE_URL=http://localhost:8005
CAREER_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007

# --- Frontend Public Variables (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Admit OS"
NEXT_PUBLIC_APP_VERSION="1.0.0"

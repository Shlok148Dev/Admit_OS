# ==============================================================================
# Admit OS — Root .gitignore
# ==============================================================================

# Environment and Virtual Environments
.venv/
venv/
env/
ENV/
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node, Next.js & Frontend Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.nuxt/
*.tsbuildinfo
.turbo/
.expo/
.expo-shared/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Machine Learning & Model Artifacts
mlruns/
*.pkl
*.joblib
*.onnx
*.pt
*.bin
models/artifacts/

# Database & Local Storage (NEVER COMMIT DATABASES OR RAW PDF DUMPS)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
data/
data/local/
data/sqlite/
data/raw/

# Secrets, Certificates & API Keys
secrets/
*.pem
*.key
*.crt
.credentials
auth_token
api_keys.json
service_account.json
firebase-adminsdk*.json

# Logs & Telemetry
logs/
*.log
npm-debug.log*

# Test Transcripts, Browser Dumps & Local Benchmarks
*transcript*.json
*results*.json
*report*.json
live_screenshots/
.tempmediaStorage/
test_output/
temp/
tmp/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform.lock.hcl

# Docker overrides
docker-compose.override.yml

# Scratch & Temporary Notes
scratch/
search_results.txt
RESULTS.md

# Conversational Scratch Runners & Diagnostic Scripts
run_*.py
validate_*.py
test_aria_*.py
test_10_*.py
test_4x_*.py
test_5x_*.py
test_category_*.py
